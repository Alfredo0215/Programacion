{
  "permissions": {
    "allow": [
      "Bash(dotnet test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell($msbuild = & *vswhere.exe* -latest -requires Microsoft.Component.MSBuild -find *)",
      "PowerShell(& $msbuild *POO26B_FSA.csproj*)"
    ],
    "deny": [
      "Edit(**/*.Designer.cs)",
      "Write(**/*.Designer.cs)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compilar.sh\"",
            "timeout": 120,
            "statusMessage": "Compilando con MSBuild..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "savvy-flow@claude-kit": true,
    "savvy-progress@claude-kit": true
  }
}
